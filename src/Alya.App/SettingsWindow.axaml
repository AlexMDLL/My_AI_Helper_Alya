<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Alya.App.SettingsWindow"
        Title="Настройки Али"
        Width="420" Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0D1522">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="16,12" Background="#1B2C42">
      <TextBlock Text="НАСТРОЙКИ" FontSize="13" FontWeight="SemiBold" Foreground="#E8F1FB" LetterSpacing="2"/>
    </Border>

    <TabControl Grid.Row="1" Margin="12">
      <TabItem Header="Основное">
        <StackPanel Spacing="10" Margin="8">
          <TextBlock Text="Модель Ollama" Foreground="#8EA4BD" FontSize="11"/>
          <TextBox x:Name="ModelBox" Watermark="qwen2.5:7b-instruct"/>
          <TextBlock Text="Голос" Foreground="#8EA4BD" FontSize="11"/>
          <ComboBox x:Name="SpeakerBox" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="xenia"/>
            <ComboBoxItem Content="baya"/>
            <ComboBoxItem Content="kseniya2"/>
            <ComboBoxItem Content="aidar"/>
            <ComboBoxItem Content="eugene"/>
          </ComboBox>
          <TextBlock Text="Тембр (0.8 — ниже, 1.3 — выше)" Foreground="#8EA4BD" FontSize="11"/>
          <Slider x:Name="PitchSlider" Minimum="0.8" Maximum="1.3" TickFrequency="0.01"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="Чат">
        <StackPanel Spacing="10" Margin="8">
          <TextBlock Text="Автоскрытие чата, секунд" Foreground="#8EA4BD" FontSize="11"/>
          <NumericUpDown x:Name="AutoHideBox" Minimum="5" Maximum="300" Increment="5"/>
          <CheckBox x:Name="TtsEnabled" Content="Озвучивать ответы" IsChecked="True"/>
          <CheckBox x:Name="AutostartBox" Content="Запускать вместе с Windows"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="Вид">
        <StackPanel Spacing="10" Margin="8">
          <TextBlock Text="Кадров в секунду анимации" Foreground="#8EA4BD" FontSize="11"/>
          <NumericUpDown x:Name="FpsBox" Minimum="24" Maximum="240" Increment="12"/>
          <TextBlock Text="Чем выше — тем плавнее и больше нагрузка." Foreground="#6F839B" FontSize="10" TextWrapping="Wrap"/>
        </StackPanel>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Padding="12" Background="#111C2B">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="StatusText" Foreground="#6F839B" FontSize="11" VerticalAlignment="Center"/>
        <Button Grid.Column="1" x:Name="SaveButton" Content="Сохранить" Margin="0,0,8,0"
                Background="#38BDF8" Foreground="#06232B" FontWeight="SemiBold" Padding="14,6"/>
        <Button Grid.Column="2" x:Name="CancelButton" Content="Отмена" Padding="14,6"/>
      </Grid>
    </Border>
  </Grid>
</Window>
