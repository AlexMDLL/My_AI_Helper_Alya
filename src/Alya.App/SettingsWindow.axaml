<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Alya.App.SettingsWindow"
        Title="Настройки Али"
        Width="470" Height="580"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8EA4BD"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#1B2C42"/>
      <Setter Property="Foreground" Value="#EAF4FF"/>
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#5EEAD4"/>
      <Setter Property="Foreground" Value="#06232B"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#38BDF8"/>
      <Setter Property="Foreground" Value="#06232B"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18,8"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8EA4BD"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="#1B2C42"/>
      <Setter Property="Foreground" Value="#EAF4FF"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#8EA4BD"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#6F839B"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="Background" Value="#141F2E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="Slider /template/ Border">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Slider">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="CornerRadius" Value="17"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="#00000000"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style Selector="Button.swatch.selected">
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
    </Style>
  </Window.Styles>

  <Border CornerRadius="18" Background="#F20D1522" BorderBrush="#33A7D8FF" BorderThickness="1" Margin="0">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <Border Grid.Row="0" x:Name="TitleBar" Padding="16,12" CornerRadius="18,18,0,0" Background="#331E3348">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,10,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#5EEAD4"/>
                <GradientStop Offset="1" Color="#38BDF8"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="А" FontWeight="Bold" FontSize="13" Foreground="#06232B"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="НАСТРОЙКИ" FontSize="12" FontWeight="SemiBold" Foreground="#EAF4FF" LetterSpacing="2"/>
            <TextBlock Text="Аля" FontSize="10" Foreground="#7F93AA"/>
          </StackPanel>
          <Button Grid.Column="2" x:Name="CancelButton" Content="✕" Classes="ghost" Padding="8,2"/>
        </Grid>
      </Border>

      <Border Grid.Row="1" Padding="10,8" Background="#141F2E">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button x:Name="NavGeneral" Content="Основное" Classes="nav active"/>
          <Button x:Name="NavBrain" Content="Мозг" Classes="nav"/>
          <Button x:Name="NavMemory" Content="Память" Classes="nav"/>
          <Button x:Name="NavChat" Content="Чат" Classes="nav"/>
          <Button x:Name="NavVoice" Content="Голос" Classes="nav"/>
          <Button x:Name="NavView" Content="Вид" Classes="nav"/>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="2" Margin="16,10">
        <Grid>
          <StackPanel x:Name="PanelGeneral" Spacing="4">
            <TextBlock Text="Характер Али" Classes="label"/>
            <TextBox x:Name="PersonaBox" AcceptsReturn="True" Height="150" TextWrapping="Wrap"
                     Watermark="Опиши, какая она: тон, манера речи, что любит…"/>
            <TextBlock Text="Это описание подмешивается в системный промпт." Classes="hint" Margin="0,6,0,0"/>
            <TextBlock Text="Имя пользователя" Classes="label"/>
            <TextBox x:Name="UserNameBox" Watermark="Александр"/>
            <TextBlock Text="Город" Classes="label"/>
            <TextBox x:Name="CityBox" Watermark="Сыктывкар"/>
          </StackPanel>

          <StackPanel x:Name="PanelBrain" Spacing="4" IsVisible="False">
            <TextBlock Text="Модель Ollama" Classes="label"/>
            <TextBox x:Name="ModelBox" Watermark="qwen2.5:7b-instruct"/>
            <TextBlock Text="Температура модели (0.5–1.2)" Classes="label"/>
            <NumericUpDown x:Name="TemperatureBox" Minimum="0.5" Maximum="1.2" Increment="0.05"/>
            <TextBlock Text="Проверка связи с моделью" Classes="label"/>
            <Button x:Name="CheckModelButton" Content="Проверить Ollama" Classes="ghost" HorizontalAlignment="Left"/>
            <TextBlock x:Name="BrainStatus" Text="—" Classes="hint" Margin="0,8,0,0"/>
            <TextBlock Text="Модель (выбор из установленных)" Classes="label"/>
            <ComboBox x:Name="ModelSelect" HorizontalAlignment="Stretch"/>
            <Button x:Name="RefreshModelsButton" Content="Обновить список" Classes="ghost" HorizontalAlignment="Left" Margin="0,6,0,0"/>
          </StackPanel>

          <StackPanel x:Name="PanelMemory" Spacing="4" IsVisible="False">
            <TextBlock Text="Что хранится" Classes="label"/>
            <TextBlock x:Name="MemorySummary" Text="—" Classes="hint"/>
            <Button x:Name="ClearMemoryButton" Content="Очистить память" Classes="ghost" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>

          <StackPanel x:Name="PanelChat" Spacing="4" IsVisible="False">
            <TextBlock Text="Автоскрытие чата, секунд" Classes="label"/>
            <NumericUpDown x:Name="AutoHideBox" Minimum="5" Maximum="300" Increment="5"/>
            <CheckBox x:Name="TtsEnabled" Content="Озвучивать ответы" IsChecked="True" Margin="0,8,0,0"/>
            <CheckBox x:Name="AutostartBox" Content="Запускать вместе с Windows" Margin="0,4,0,0"/>
            <CheckBox x:Name="BubblesBox" Content="Пузыри над персонажем" Margin="0,4,0,0"/>
            <CheckBox x:Name="CareBox" Content="Забота: реакции на игры и работу" Margin="0,4,0,0"/>
          </StackPanel>

          <StackPanel x:Name="PanelVoice" Spacing="4" IsVisible="False">
            <TextBlock Text="Голос Silero" Classes="label"/>
            <ComboBox x:Name="SpeakerBox" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Ксения 2 (xenia)"/>
              <ComboBoxItem Content="Бая (baya)"/>
              <ComboBoxItem Content="Ксения (kseniya)"/>
              <ComboBoxItem Content="Айдар (aidar)"/>
              <ComboBoxItem Content="Юджин (eugene)"/>
            </ComboBox>
            <TextBlock x:Name="PitchLabel" Text="Тембр — 1.20" Classes="label"/>
            <Slider x:Name="PitchSlider" Minimum="0.8" Maximum="1.3" TickFrequency="0.01"/>
            <Button x:Name="PreviewVoiceButton" Content="Прослушать" Classes="ghost" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            <CheckBox x:Name="AlwaysListenBox" Content="Слышать всегда (иначе только по имени «Аля»)" Margin="0,10,0,0"/>
          </StackPanel>

          <StackPanel x:Name="PanelView" Spacing="4" IsVisible="False">
            <CheckBox x:Name="FullscreenBox" Content="Полноэкранный режим (за панелью задач)" Margin="0,6,0,0"/>
            <CheckBox x:Name="DragEnabledBox" Content="Разрешить перетаскивание" Margin="0,4,0,0"/>
            <CheckBox x:Name="FallEnabledBox" Content="Физика падения" Margin="0,4,0,0"/>
            <CheckBox x:Name="PetEnabledBox" Content="Поглаживания" Margin="0,4,0,0"/>
            <TextBlock Text="Кадров в секунду" Classes="label"/>
            <NumericUpDown x:Name="FpsBox" Minimum="24" Maximum="240" Increment="12"/>
            <TextBlock x:Name="OpacityLabel" Text="Прозрачность — 100%" Classes="label"/>
            <Slider x:Name="OpacitySlider" Minimum="0.6" Maximum="1" TickFrequency="0.02"/>
            <TextBlock Text="Цвет акцента" Classes="label"/>
            <StackPanel Orientation="Horizontal" Spacing="0">
              <Button x:Name="SwatchTeal" Classes="swatch" Background="#5EEAD4" Tag="#5EEAD4"/>
              <Button x:Name="SwatchBlue" Classes="swatch" Background="#38BDF8" Tag="#38BDF8"/>
              <Button x:Name="SwatchPink" Classes="swatch" Background="#F472B6" Tag="#F472B6"/>
              <Button x:Name="SwatchPurple" Classes="swatch" Background="#A78BFA" Tag="#A78BFA"/>
              <Button x:Name="SwatchOrange" Classes="swatch" Background="#FB923C" Tag="#FB923C"/>
            </StackPanel>
            <TextBlock Text="Свой цвет (RGB)" Classes="label"/>            <TextBlock Text="HEX" Classes="label"/>
            <TextBox x:Name="HexBox" Text="#38BDF8" MaxLength="7" Width="120" HorizontalAlignment="Left"/>
            <Border Height="10" CornerRadius="5" Margin="0,8,0,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Offset="0" Color="#FF0000"/>
                  <GradientStop Offset="0.17" Color="#FFFF00"/>
                  <GradientStop Offset="0.33" Color="#00FF00"/>
                  <GradientStop Offset="0.5" Color="#00FFFF"/>
                  <GradientStop Offset="0.66" Color="#0000FF"/>
                  <GradientStop Offset="0.83" Color="#FF00FF"/>
                  <GradientStop Offset="1" Color="#FF0000"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border x:Name="AccentPreview" Width="38" Height="38" CornerRadius="19" Background="#38BDF8" HorizontalAlignment="Left" Margin="0,4,0,6"/>
            <Grid ColumnDefinitions="20,*,44" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Classes="label" VerticalAlignment="Center"/>
              <Slider Grid.Row="0" Grid.Column="1" x:Name="RedSlider" Minimum="0" Maximum="255" Value="56"/>
              <TextBlock Grid.Row="0" Grid.Column="2" x:Name="RedValue" Text="56" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Classes="label" VerticalAlignment="Center"/>
              <Slider Grid.Row="1" Grid.Column="1" x:Name="GreenSlider" Minimum="0" Maximum="255" Value="189"/>
              <TextBlock Grid.Row="1" Grid.Column="2" x:Name="GreenValue" Text="189" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Classes="label" VerticalAlignment="Center"/>
              <Slider Grid.Row="2" Grid.Column="1" x:Name="BlueSlider" Minimum="0" Maximum="255" Value="248"/>
              <TextBlock Grid.Row="2" Grid.Column="2" x:Name="BlueValue" Text="248" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>            <TextBlock Text="Чем выше FPS — тем плавнее и больше нагрузка." Classes="hint" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="3" Padding="14,10" Background="#111C2B" CornerRadius="0,0,18,18">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock x:Name="StatusText" Foreground="#6F839B" FontSize="11" VerticalAlignment="Center"/>
          <Button Grid.Column="1" x:Name="SaveButton" Content="Сохранить" Classes="primary" Margin="0,0,8,0"/>
          <Button Grid.Column="2" Content="Отмена" Classes="ghost" Click="OnCancel"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
