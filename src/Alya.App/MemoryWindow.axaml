<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Alya.App"
        x:Class="Alya.App.MemoryWindow"
        Title="Память Али"
        Width="880" Height="580"
        MinWidth="620" MinHeight="420"
        Background="#070B14"
        WindowStartupLocation="CenterOwner">
  <Grid ColumnDefinitions="*,300" RowDefinitions="*,Auto">
    <local:MemoryGraph x:Name="Graph" Grid.RowSpan="2"/>
    <Border Grid.Column="1" Grid.RowSpan="2" Background="#0C1524" BorderBrush="#1E3A5F" BorderThickness="1,0,0,0">
      <ScrollViewer Margin="14">
        <StackPanel Spacing="10">
          <TextBlock Text="УЗЕЛ ПАМЯТИ" FontSize="11" LetterSpacing="2" Foreground="#5F7FA8"/>
          <TextBlock x:Name="NodeTitle" Text="Нажми на кружок" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#EAF4FF"/>
          <TextBlock x:Name="NodeKind" Text="" FontSize="11" Foreground="#7CE7FF"/>
          <TextBlock Text="Связано с" FontSize="11" Foreground="#5F7FA8" Margin="0,6,0,0"/>
          <ItemsControl x:Name="ConnectionsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="#9FC4E8" FontSize="12" Margin="0,2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="DeleteButton" Content="Забыть это" HorizontalAlignment="Left" Margin="0,10,0,0"
                  Background="#33223044" Foreground="#FF9AA8" BorderThickness="0" CornerRadius="8" Padding="10,5"/>
          <Button x:Name="CloseButton" Content="Закрыть" HorizontalAlignment="Left" Margin="0,6,0,0"
                  Background="#1C2B3F" Foreground="#CFE2F5" BorderThickness="0" CornerRadius="8" Padding="10,5"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
