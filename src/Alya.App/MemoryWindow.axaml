<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Alya.App"
        x:Class="Alya.App.MemoryWindow"
        Title="Память Али"
        Width="880" Height="580"
        MinWidth="620" MinHeight="420"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">
  <Border CornerRadius="16" Background="#D90A1120" BorderBrush="#33A7D8FF" BorderThickness="1" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,300">
      <Border Grid.ColumnSpan="2" x:Name="TitleBar" Background="#B3121A2A" Padding="14,9" CornerRadius="16,16,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="ПАМЯТЬ АЛИ" FontSize="12" FontWeight="SemiBold" LetterSpacing="2" Foreground="#EAF4FF"/>
            <TextBlock Text="перетащи за эту полосу · колесо — зум · тяни фон — панорама" FontSize="10" Foreground="#7F93AA" VerticalAlignment="Center"/>
          </StackPanel>
          <Button Grid.Column="1" x:Name="HeaderCloseButton" Content="✕" Background="Transparent" Foreground="#8EA4BD" BorderThickness="0" Padding="8,0"/>
        </Grid>
      </Border>

      <local:MemoryGraph x:Name="Graph" Grid.Row="1"/>
      <Border Grid.Column="1" Grid.Row="1" Background="#B30C1524" BorderBrush="#1E3A5F" BorderThickness="1,0,0,0">
        <ScrollViewer Margin="14">
          <StackPanel Spacing="10">
            <TextBlock Text="УЗЕЛ ПАМЯТИ" FontSize="11" LetterSpacing="2" Foreground="#5F7FA8"/>
            <TextBlock x:Name="NodeTitle" Text="Нажми на кружок" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#EAF4FF"/>
            <TextBlock x:Name="NodeKind" Text="" FontSize="11" Foreground="#7CE7FF"/>
            <TextBlock Text="Связано с" FontSize="11" Foreground="#5F7FA8" Margin="0,6,0,0"/>
            <ItemsControl x:Name="ConnectionsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="#9FC4E8" FontSize="12" Margin="0,2"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="DeleteButton" Content="Забыть это" HorizontalAlignment="Left" Margin="0,10,0,0"
                    Background="#33223044" Foreground="#FF9AA8" BorderThickness="0" CornerRadius="8" Padding="10,5"/>
            <Button x:Name="CloseButton" Content="Закрыть" HorizontalAlignment="Left" Margin="0,6,0,0"
                    Background="#1C2B3F" Foreground="#CFE2F5" BorderThickness="0" CornerRadius="8" Padding="10,5"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Border>
</Window>
