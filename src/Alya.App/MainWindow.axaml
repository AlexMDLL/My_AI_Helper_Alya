<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Alya.App"
        x:Class="Alya.App.MainWindow"
        Title="Аля"
        Width="780" Height="720"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual">
  <Window.Styles>
    <Style Selector="Button.send">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.send:pointerover">
      <Setter Property="Background" Value="#5EEAD4"/>
      <Setter Property="Opacity" Value="0.95"/>
    </Style>
    <Style Selector="Button#CloseButton:pointerover">
      <Setter Property="Foreground" Value="#FF7B8C"/>
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="Auto,*">

    <Border Grid.Column="0" x:Name="ChatPanel" Width="380" CornerRadius="20"
            RenderTransformOrigin="0,0"
            BorderBrush="#33A7D8FF"
            BorderThickness="1"
            Margin="0"
            Opacity="1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#E8142233"/>
          <GradientStop Offset="1" Color="#E60A1018"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" x:Name="HeaderBar" Padding="14,12" CornerRadius="20,20,0,0" Background="#331E3348">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Offset="0" Color="#5EEAD4"/>
                  <GradientStop Offset="1" Color="#38BDF8"/>
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock Text="А" FontSize="16" FontWeight="Bold" Foreground="#06232B"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="АЛЯ" FontSize="14" FontWeight="SemiBold" Foreground="#EAF4FF" LetterSpacing="2"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="StatusText" Text="на связи" FontSize="11" Foreground="#8EA4BD"/>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Ellipse x:Name="BrainDot" Width="7" Height="7" Fill="#7F93AA" ToolTip.Tip="Мозг (Ollama)"/>
                  <Ellipse x:Name="EarsDot" Width="7" Height="7" Fill="#7F93AA" ToolTip.Tip="Слух (микрофон)"/>
                  <Ellipse x:Name="VoiceDot" Width="7" Height="7" Fill="#7F93AA" ToolTip.Tip="Голос (TTS)"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" x:Name="SettingsButton" Content="⚙" Background="Transparent" Foreground="#8EA4BD" BorderThickness="0" Padding="8,2" VerticalAlignment="Top" Margin="0,0,4,0"/>
            <Button Grid.Column="3" x:Name="CloseButton" Content="✕" Background="Transparent"
                    Foreground="#8EA4BD" BorderThickness="0" Padding="8,2" VerticalAlignment="Top"/>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="12,10" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="MessagesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:Bubble">
                <Border CornerRadius="16" Padding="11,8" Margin="0,4" MaxWidth="320"
                        HorizontalAlignment="{Binding Alignment}"
                        Background="{Binding Background}"
                        BoxShadow="0 6 18 0 #44000000">
                  <StackPanel>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="#EAF1FA" LineHeight="19"/>
                    <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#7F93AA" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="12" Padding="8" CornerRadius="16"
                Background="#66162638" BorderBrush="#334A6B8C" BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="InputBox" Watermark="Сообщение…" Background="Transparent" BorderThickness="0"
                     FontSize="13" VerticalContentAlignment="Center" Padding="6,0"/>
            <Button Grid.Column="1" x:Name="SendButton" Classes="send" Content="→" Width="40" Height="36" CornerRadius="13"
                    Background="#38BDF8" Foreground="#06232B" FontWeight="Bold" FontSize="16"/>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Image x:Name="CharacterImage" Stretch="UniformToFill" Width="324" Height="{Binding $parent[Window].Height}" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,0,0" RenderTransformOrigin="0.5,1" RenderOptions.BitmapInterpolationMode="HighQuality"/>
      <Image x:Name="CharacterFade" Stretch="Uniform" Width="324" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,0" RenderTransformOrigin="0.5,1" Opacity="0" IsVisible="False" IsHitTestVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality"/>
      <Border x:Name="SpeechBubble" IsVisible="False" MaxWidth="300" HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="10,18,10,0" Padding="12,9" CornerRadius="14" Background="#FF16243A"
              BorderBrush="#335EEAD4" BorderThickness="1" BoxShadow="0 8 24 0 #66000000">
        <TextBlock x:Name="SpeechText" Text="" TextWrapping="Wrap" FontSize="12.5" Foreground="#EAF1FA"/>
      </Border>
    </Grid>
  </Grid>
</Window>
